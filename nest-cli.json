{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/producer/src",
  "monorepo": true,
  "root": "apps/producer",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/producer/tsconfig.app.json"
  },
  "projects": {
    "producer": {
      "type": "application",
      "root": "apps/producer",
      "entryFile": "main",
      "sourceRoot": "apps/producer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/producer/tsconfig.app.json"
      }
    },
    "consumer-a": {
      "type": "application",
      "root": "apps/consumer-a",
      "entryFile": "main",
      "sourceRoot": "apps/consumer-a/src",
      "compilerOptions": {
        "tsConfigPath": "apps/consumer-a/tsconfig.app.json"
      }
    },
    "consumer-b": {
      "type": "application",
      "root": "apps/consumer-b",
      "entryFile": "main",
      "sourceRoot": "apps/consumer-b/src",
      "compilerOptions": {
        "tsConfigPath": "apps/consumer-b/tsconfig.app.json"
      }
    },
    "kafka-config": {
      "type": "library",
      "root": "libs/kafka-config",
      "entryFile": "index",
      "sourceRoot": "libs/kafka-config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kafka-config/tsconfig.lib.json"
      }
    },
    "logger": {
      "type": "library",
      "root": "libs/logger",
      "entryFile": "index",
      "sourceRoot": "libs/logger/src",
      "compilerOptions": {
        "tsConfigPath": "libs/logger/tsconfig.lib.json"
      }
    },
    "schema-registry": {
      "type": "library",
      "root": "libs/schema-registry",
      "entryFile": "index",
      "sourceRoot": "libs/schema-registry/src",
      "compilerOptions": {
        "tsConfigPath": "libs/schema-registry/tsconfig.lib.json"
      }
    }
  }
}
